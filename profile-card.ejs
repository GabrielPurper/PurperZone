<% /*
  GUIA DE MANUTENÇÃO — profile-card.ejs
  Objetivo: Fragmento reutilizável de interface renderizado por um servidor EJS.
  Como modificar: Este arquivo é um template de servidor: GitHub Pages não executa EJS por conta própria. Preserve nomes de variáveis e escape saídas dinâmicas.
  Segurança: escape conteúdo dinâmico e não coloque segredos ou tokens neste template.
*/ %>
<article class="card profile-card"><img class="avatar avatar--large" src="<%= profile?.avatar_url || 'avatar-placeholder.svg' %>" alt="Avatar de <%= profile?.display_name || profile?.username || 'perfil' %>" loading="lazy"><div><h3><%= profile?.display_name || profile?.username || 'Perfil' %></h3><p class="muted">@<%= profile?.username || 'usuario' %></p><% if (profile?.bio) { %><p><%= profile.bio %></p><% } %><a class="btn" href="profile.html?username=<%= encodeURIComponent(profile?.username || '') %>">Ver perfil</a></div></article>
