<article class="card message-card" data-conversation-id="<%= message?.conversation_id || '' %>"><img class="avatar" src="<%= message?.sender?.avatar_url || 'avatar-placeholder.svg' %>" alt=""><div class="message-card__body"><strong><%= message?.sender?.display_name || message?.sender?.username || 'Mensagem' %></strong><p><%= message?.content || 'Anexo enviado' %></p><small class="muted"><%= message?.created_at ? new Date(message.created_at).toLocaleString('pt-BR') : '' %></small></div><a class="btn" href="messages.html?conversation=<%= encodeURIComponent(message?.conversation_id || '') %>">Abrir conversa</a></article>
