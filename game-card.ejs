<% /*
  GUIA DE MANUTENÇÃO — game-card.ejs
  Objetivo: Fragmento reutilizável de interface renderizado por um servidor EJS.
  Como modificar: Este arquivo é um template de servidor: GitHub Pages não executa EJS por conta própria. Preserve nomes de variáveis e escape saídas dinâmicas.
  Segurança: escape conteúdo dinâmico e não coloque segredos ou tokens neste template.
*/ %>
<article class="card game-card"><% if (game?.cover_url) { %><img class="game-card__cover" src="<%= game.cover_url %>" alt="Capa de <%= game?.title || 'jogo' %>" loading="lazy"><% } %><div><h3><%= game?.title || 'Jogo' %></h3><p class="muted"><%= game?.platform || 'Plataforma não informada' %></p><% if (game?.status) { %><span class="tag"><%= game.status %></span><% } %><a class="btn" href="library.html?game=<%= encodeURIComponent(game?.id || '') %>">Ver biblioteca</a></div></article>
